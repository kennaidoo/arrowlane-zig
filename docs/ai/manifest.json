{
  "schema_version": 1,
  "kind": "arrowlane",
  "name": "arrowlane-zig",
  "version": "0.3.0",
  "status": "release-candidate",
  "frame": {
    "magic": "ALN1",
    "version": 1,
    "prefix_bytes": 38,
    "max_header_bytes": 65535,
    "max_payload_bytes": 536870912,
    "max_uncompressed_bytes": 1073741824
  },
  "streaming": {
    "default_chunk_rows": 50000,
    "max_chunks": 1000000,
    "implemented": "fixture"
  },
  "lanes": {
    "json": "fixture",
    "ipc": "fixture",
    "ipc-zstd": "fixture",
    "shm": "fixture-posix"
  },
  "selector": {
    "implemented": true,
    "parity_cases": 324,
    "parity_result": "pass"
  },
  "schema": {
    "implemented": "general",
    "nullable_variants": true,
    "fixture_schema_bytes": 480,
    "common_types": ["null", "int", "floating", "binary", "large_binary", "utf8", "large_utf8", "bool", "decimal", "date", "time", "timestamp", "duration"],
    "general_arrow_schema": true,
    "flatbuffer_defaults": true
  },
  "c_abi": true,
  "bench": true,
  "fuzz": {
    "implemented": "linux",
    "command": "zig build fuzz",
    "coverage_guided": false,
    "inputs": 10000
  },
  "shm": {
    "implemented": "fixture-posix",
    "cli": false,
    "platforms": ["linux", "macos", "freebsd"]
  },
  "performance": "docs/performance.md",
  "platforms": {
    "windows": "x86_64 CI; aarch64 cross-build only; shm unavailable",
    "linux": "x86_64 and aarch64 CI; fixture shm lane and fuzz gate",
    "macos": "arm64 CI; fixture shm lane; fuzz not supported",
    "freebsd": "aarch64 CI; fixture shm lane with ARROWLAND_SHM_DIR"
  }
}
